# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Design handoff reference (local-only; not part of the codebase)
/claudeDesign

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage

# backfill/seed audit logs (one-off ops scripts write CSV audit trails to cwd)
backfill-*.csv
seed-*.csv
# Same convention for the asset-ingest converters (convert-draw9-landing-*). Their rows carry
# ABSOLUTE source paths from whoever ran them, so they are machine-local run records, not
# repo content.
*-audit.csv
# migrate-normalise-mobiles writes one row per changed account: userId, EMAIL and PHONE NUMBER.
# Its default output path now lives under /temp (already ignored below), but a run that predates
# that change — or one given an explicit --csv at the repo root — drops the file here. Ignored by
# name too, because a 6,000-row PII file is not something to catch on review.
mobile-migration*.csv

# scratch / read-only probe scripts + ops CSV audit output (may contain PII) — never commit/build
/temp

# next.js
/.next/
# The e2e harness compiles here instead, so its NEXT_PUBLIC_* values never
# land in the cache the dev server serves (next.config.ts distDir).
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# superpowers brainstorm scratch
.superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code hook state (transient — do not commit)
.claude/.touched-files
.claude/.session-state
.claude/.typecheck-gate-attempts

# git worktrees (each is a sibling checkout — see docs/dev-tooling/worktrees.md)
.worktrees/

# Local dev server log captured by `npm run dev | tee dev.log` during smoke runs
dev.log

# Playwright e2e artifacts (reports, videos, auth states, proof output)
e2e-artifacts/
# Playwright MCP server scratch output (console logs + page snapshots), written into the repo
# root whenever a session drives a browser through the MCP tools.
.playwright-mcp/
