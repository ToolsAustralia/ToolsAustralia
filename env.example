# Database
MONGODB_URI=mongodb://localhost:27017/tools-australia

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Product IDs (subscription packages)
STRIPE_PRODUCT_ID_TRADIE=prod_TE0vzyE4UytXFj
STRIPE_PRODUCT_ID_FOREMAN=prod_TE0wgcnAM9MM1K
STRIPE_PRODUCT_ID_BOSS=prod_TE0wxAcpcp6Tlv

# Stripe Price IDs (subscription packages)
STRIPE_PRICE_ID_TRADIE=price_1SHYu3QxMEki11tJh7jTlC6V
STRIPE_PRICE_ID_FOREMAN=price_1SHYuQQxMEki11tJV9bEYh1B
STRIPE_PRICE_ID_BOSS=price_1SHYugQxMEki11tJ3XjLuZ4i

# Facebook Pixel & Conversions API
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID: Facebook Pixel ID (used for both browser pixel and Conversions API)
# FACEBOOK_ACCESS_TOKEN: Access token for Conversions API (required for server-side tracking)
#   Get it from: https://business.facebook.com/events_manager2 -> Your Pixel -> Settings -> Conversions API
# FACEBOOK_TEST_EVENT_CODE: Test event code for testing Conversions API (optional)
#   Get it from: Meta Events Manager -> Test Events tab
# FACEBOOK_USE_TEST_EVENTS: Set to "true" to use test events in staging (Vercel sets NODE_ENV=production there)
#   Use FACEBOOK_TEST_EVENT_CODE + FACEBOOK_USE_TEST_EVENTS=true for staging/preview deployments
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_TEST_EVENT_CODE=your-test-event-code
# FACEBOOK_USE_TEST_EVENTS=true

# Facebook Marketing API (for Ad Performance Tracking)
# FACEBOOK_MARKETING_ACCESS_TOKEN: System User Access Token for Marketing API (recommended - never expires)
#   Get it from: Facebook Business Manager -> Business Settings -> System Users -> Create System User
#   Assign to your Facebook App and generate token with 'ads_read' permission
#   Format: A long-lived token that never expires (unless revoked)
# FACEBOOK_AD_ACCOUNT_ID: Your Facebook Ad Account ID
#   Format: act_123456789 (include 'act_' prefix)
#   Find it in: Facebook Ads Manager -> Account Settings -> Account ID
FACEBOOK_MARKETING_ACCESS_TOKEN=your-system-user-access-token
FACEBOOK_AD_ACCOUNT_ID=act_your-ad-account-id

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id

# Klaviyo Client-Side Integration (onsite JavaScript)
# NEXT_PUBLIC_KLAVIYO_COMPANY_ID: Klaviyo Company ID for client-side tracking
#   Get it from: Klaviyo Dashboard -> Settings -> Account -> Company ID
#   Format: X2Lz2L (example)
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=X2Lz2L

# Development Testing (optional - enables pixels in development mode)
NEXT_PUBLIC_ENABLE_PIXEL_TESTING=false

# SendGrid (for transactional email)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Domain must be authenticated in SendGrid. Sender addresses (verify-email@, reset-password@,
# no-reply@, support@) are defined per email type - SENDGRID_FROM_EMAIL/FROM_NAME are NOT used.
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
# Optional: If you get 400 "sender not verified", set to your SendGrid subdomain (e.g. em7481.toolsaustralia.com.au)
# SENDGRID_FROM_DOMAIN=em7481.toolsaustralia.com.au
EMAIL_ENABLED=true
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000

# Recipient for contact form and partner application notifications
CONTACT_EMAIL=support@toolsaustralia.com.au

# Email Verification: 3 attempts per 5 minutes, 24hr code expiry
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440
EMAIL_VERIFICATION_RATE_LIMIT_PER_5MIN=3

# Password Reset: 3 attempts per 5 minutes, 24hr link expiry
PASSWORD_RESET_EXPIRY_MINUTES=1440

# Contact/Partner forms: 1 request per 5 minutes (hardcoded)


# App Configuration
# IMPORTANT: In production, set this to your actual domain (e.g., https://toolsaustralia.com.au)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tools Australia

# Feature Flags
REWARDS_ENABLED=false
NEXT_PUBLIC_REWARDS_ENABLED=false
REWARDS_DISABLED_MESSAGE="Rewards are currently unavailable while we make improvements."
NEXT_PUBLIC_REWARDS_DISABLED_MESSAGE="Rewards are currently unavailable while we make improvements."

# Admin Configuration
ADMIN_EMAIL=admin@toolsaustralia.com
ADMIN_PASSWORD=your-admin-password

# Development
NODE_ENV=development

# Klaviyo (for email marketing automation)
KLAVIYO_PRIVATE_API_KEY=pk_your-klaviyo-private-api-key-here
KLAVIYO_ENABLED=true
KLAVIYO_MODE=development
# Email List ID for subscribing users to email marketing (get from Klaviyo dashboard -> Lists & Segments)
KLAVIYO_EMAIL_LIST_ID=your-email-list-id-here
# SMS List ID for subscribing users to SMS marketing (get from Klaviyo dashboard -> Lists & Segments)
KLAVIYO_SMS_LIST_ID=your-sms-list-id-here

# Production Environment Variables (for Vercel deployment):
# NODE_ENV=production
# KLAVIYO_MODE=production
# STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com

# Note: Set KLAVIYO_MODE=production when deploying to production to avoid warnings