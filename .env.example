# .env.example — the canonical registry of every env var the app reads.
#
# This file is TRACKED (rescued from the `.env*` ignore by `!.env.example` in
# .gitignore) and is the SINGLE SOURCE OF TRUTH for WHICH env vars exist.
#   • .env.local — per-folder VALUES (gitignored; never merges between folders/worktrees)
#   • Vercel     — production values (set them there too)
# There is NO runtime env validation (src/lib/environment.ts only detects NODE_ENV),
# so this list must be kept complete BY HAND.
#
# When you add an env var: register it HERE (with a comment + a SAFE placeholder —
# NEVER a real secret value) in the SAME commit, then set the value in your .env.local,
# the main folder's .env.local, and Vercel. Detect drift with:
#     npm run check:env       # this folder vs .env.example (exits 1 on a missing var)
#     npm run check:env:all   # main folder + every git worktree
# See CLAUDE.md §9.
#
# NOT listed here (legitimately per-folder — allowlisted in scripts/check-env.mjs):
#   PORT              — assigned per-worktree by wt-new.sh (main uses 3000)
#   E2E_TEST_USER_*   — branch-local end-to-end test credentials

# ─── App / runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Tools Australia
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Database (MongoDB + Redis) ─────────────────────────────────────────────────
MONGODB_URI=
MONGODB_MAX_POOL=
REDIS_URL=

# ─── Auth (NextAuth + Google OAuth + verification) ──────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_RESET_EXPIRY_MINUTES=
EMAIL_VERIFICATION_EXPIRY_MINUTES=
EMAIL_VERIFICATION_RATE_LIMIT_PER_5MIN=

# ─── Stripe (billing) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TRADIE=
STRIPE_PRICE_ID_FOREMAN=
STRIPE_PRICE_ID_BOSS=
STRIPE_PRODUCT_ID_TRADIE=
STRIPE_PRODUCT_ID_FOREMAN=
STRIPE_PRODUCT_ID_BOSS=

# ─── Email — SendGrid (transactional) ───────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_NAME=Tools Australia
EMAIL_FROM=
EMAIL_ENABLED=false
CONTACT_EMAIL=
EMAIL_RETRY_ATTEMPTS=
EMAIL_RETRY_DELAY_MS=

# ─── Marketing — Klaviyo ────────────────────────────────────────────────────────
KLAVIYO_ENABLED=false
KLAVIYO_MODE=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_EMAIL_LIST_ID=
KLAVIYO_SMS_LIST_ID=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=

# ─── Tracking — Meta / Facebook (Pixel + CAPI) ──────────────────────────────────
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_MARKETING_ACCESS_TOKEN=
FACEBOOK_USE_TEST_EVENTS=false
FACEBOOK_TEST_EVENT_CODE=

# ─── Tracking — TikTok (Pixel + Events API) ─────────────────────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_MARKETING_ACCESS_TOKEN=
TIKTOK_USE_TEST_EVENTS=false
TIKTOK_TEST_EVENT_CODE=

# ─── Tracking — Google Analytics / GTM / Hotjar ─────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_ENABLE_GTM_TESTING=false
NEXT_PUBLIC_ENABLE_PIXEL_TESTING=false
NEXT_PUBLIC_PIXEL_ALLOWED_HOSTNAMES=

# ─── Media — Cloudinary + AWS S3 ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ─── Rewards ────────────────────────────────────────────────────────────────────
REWARDS_ENABLED=false
NEXT_PUBLIC_REWARDS_ENABLED=false

# ─── Cron / webhooks / debug ────────────────────────────────────────────────────
CRON_SECRET=
WEBHOOK_VERBOSE_LOGGING=false
NEXT_PUBLIC_ENABLE_AUTH_DEBUG=false

# ─── Stripe webhook worker ──────────────────────────────────────────────────────
# Required: gates the internal worker route POST /api/stripe/process-event.
# Without this, the receiver enqueues Stripe events but every dispatch to the
# worker returns 500 "Worker not configured" and the queue stalls.
# Generate with: openssl rand -hex 32   (32+ chars required)
# See: docs/billing-stripe/STRIPE_WEBHOOK_QUEUE.md
STRIPE_WORKER_INTERNAL_SECRET=

# ─── Internal Norm API — see docs/internal-norm/ ────────────────────────────────
NORM_BEARER_TOKEN=
NORM_SIGNING_SECRET=
NORM_DISABLED_REGISTRY_KEYS=

# ─── iGoDirect / MyRewards SSO ("Tools Australia Rewards") — partner-discount portal ─
# Signs the HS256 JWT for POST https://<domain_url>/generatetoken. Issued per-client
# by MyRewards. The SECRET is sensitive: keep it ONLY in .env.local / Vercel — never
# commit a real value here. The other three are non-secret tenant identifiers
# (production values shown for reference). See docs/auth/igodirect-sso-masterplan.md.
IGODIRECT_SSO_SECRET=
IGODIRECT_CLIENT_ID=2412
IGODIRECT_DOMAIN_CODE=ToolsAustralia
IGODIRECT_DOMAIN_URL=myrewards.toolsaustralia.com.au

# Rewards SSO GO-LIVE GATE. POST /api/partner-discount/sso is INERT in production (returns 404)
# unless this is exactly "true". Keep it UNSET in prod until rewards SSO is cleared to launch
# (after the vendor deprovisioning + member_level + member-deletion/DPA answers). Always enabled
# in local dev so the /dev/rewards-sso harness works. See docs/auth/igodirect-sso-implementation-plan.md.
PARTNER_DISCOUNT_SSO_ENABLED=
# CLIENT twin of the above — gates the portal UI (the dashboard "Reward portal" button +
# the Rewards-page "Open partner portal" button; shows "Coming soon" while unset). The route
# reads the server var above; client-rendered buttons can only read NEXT_PUBLIC_* vars, so set
# BOTH to the same value. Read via partnerDiscountSsoEnabled() in src/config/featureFlags.ts.
NEXT_PUBLIC_PARTNER_DISCOUNT_SSO_ENABLED=

# Member-status API bearer secret. iGoDirect's MyRewards portal presents this as
# `Authorization: Bearer <key>` on GET /api/partner-discount/member-status (their live
# read of a member's discount access at sign-in / page load / redemption). WE mint it
# (≥32 random bytes) and hand it to iGoDirect over a secure channel. Sensitive: keep the
# real value ONLY in .env.local / Vercel. Unset ⇒ the route fails CLOSED (500).
# See docs/partner/igodirect-member-status-api-plan.md.
IGODIRECT_MEMBER_STATUS_KEY=
# Member-status GO-LIVE GATE. GET /api/partner-discount/member-status returns 503
# {"error":"disabled"} in production unless this is exactly "true". Always enabled in
# local dev. Flip in Vercel when iGoDirect is ready to point their portal at us.
IGODIRECT_MEMBER_STATUS_ENABLED=

# ─── Affiliate ──────────────────────────────────────────────────────────────────
# Optional: dedicated secret for the AFFILIATE portal's JWT (affiliate_token).
# When set, affiliate tokens are cryptographically separated from the member /
# NextAuth tokens (which use NEXTAUTH_SECRET) and can be rotated independently.
# Falls back to NEXTAUTH_SECRET when unset, so the app still works without it.
# NOTE: setting (or later rotating) this invalidates all existing affiliate
# sessions — affiliates simply log in again once. Generate: openssl rand -hex 32
# See: docs/auth/SECRET_ROTATION.md
AFFILIATE_JWT_SECRET=

# ─── Production DB probe ─────────────────────────────────────────────────────────
# Optional: a SEPARATE, explicit connection string to the PRODUCTION database,
# used ONLY by read-only verification probes/reconciliation runs (e.g.
# temp/readonly/*.mjs). Keeping prod access in its own var avoids accidentally
# pointing your normal MONGODB_URI at prod. The Atlas connection string usually
# has NO /<dbName> path — the probes resolve the app DB ("Production") at runtime.
# Read-only use only; never run a write/migration against this without intent.
PROD_MONGODB_URI=

# ─── AI support chatbot (Cobber) — docs/ai-chatbot/ ─────────────────────────────
# First-party Anthropic API key. Set a low customer-set monthly SPEND LIMIT
# in the Anthropic Console (it hard-stops at the cap) as the provider-side cost ceiling.
# This is a FAQ-only bot — no member account data is accessed via the chat.
ANTHROPIC_API_KEY=
# Cheapest capable model for the LLM fallback; escalation model for rare hard cases.
CHAT_MODEL_PRIMARY=claude-haiku-4-5
CHAT_MODEL_ESCALATION=claude-sonnet-4-6
# App-level daily spend ceiling (USD). The cost guard flips to a canned "support is
# busy" reply (no LLM call) once a UTC day's estimated spend exceeds this. Fail-closed.
CHAT_DAILY_TOKEN_BUDGET_USD=5
# Break-glass kill switch — set to "true" to disable Cobber instantly: hides the
# chat bubble site-wide AND blocks the generative path (canned "busy" reply, no
# LLM call). This is the env OVERRIDE — it wins over, and locks, the admin
# "Cobber availability" Pause toggle (Admin → Team → Chatbot), which is DB-backed
# and needs no deploy. For normal pausing prefer the admin toggle; use this when
# you can't reach the admin panel. Mirrors the Norm gateway kill-switch.
CHAT_KILL_SWITCH=false
# hCaptcha — guest generative gate (Task 1.8).
# Server secret for POST https://api.hcaptcha.com/siteverify (fail-closed:
# if HCAPTCHA_SECRET is unset, ALL anonymous generative turns are blocked;
# FAQ deflection and authenticated members are unaffected).
# Client sitekey is public and used by the Task 1.9 widget.
# Get both from https://dashboard.hcaptcha.com/
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# OPEN guest generative access WITHOUT hCaptcha: set "true" and anonymous guests reach
# the LLM directly (routed to the cheap Gemini provider — see resolveActorProvider),
# protected only by the per-IP generative rate limit + the daily budget. Default off =
# guests stay FAQ-only (fail-closed). When on, requires GOOGLE_GENERATIVE_AI_API_KEY
# (guests always use Gemini) or guest turns fall back to the canned reply.
CHAT_ALLOW_GUEST_GENERATIVE=false
# Per-user LLM-answer rate cap. FAQ deflection is NEVER counted against this limit —
# only genuine model-backed answers are. Limiter fails open (Mongo hiccup allows).
# The daily budget (fail-closed) remains the cost backstop.
# Defaults: 5 LLM answers per 300 seconds (5 minutes) per user (member → userId, anon → IP).
CHAT_GENERATIVE_LIMIT_MAX=5
CHAT_GENERATIVE_LIMIT_WINDOW_SECONDS=300
# GOOGLE_GENERATIVE_AI_API_KEY — read automatically by @ai-sdk/google. Required when
# EITHER the admin toggles the member provider to Gemini, OR CHAT_ALLOW_GUEST_GENERATIVE
# is on (guests ALWAYS use Gemini). Unset → those turns fall back to the canned reply.
# Gemini model IDs override defaults (gemini-2.5-flash-lite / gemini-2.5-flash).
GOOGLE_GENERATIVE_AI_API_KEY=
CHAT_GOOGLE_MODEL_PRIMARY=gemini-2.5-flash-lite
CHAT_GOOGLE_MODEL_ESCALATION=gemini-2.5-flash
