# Copy to .env.local and fill in real values. Real secrets stay out of git
# (.env* is gitignored); this file — kept via the !.env.example negation — is the
# committed reference of every env var the codebase uses. Comments only mark groups.

# ── Core / app ──
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tools Australia
NEXT_PUBLIC_IMAGE_HOSTS=
PORT=3000

# ── Database (MongoDB) ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/toolsaustralia
MONGODB_MAX_POOL=10
PROD_MONGODB_URI=
PROD_DB_NAME=Production

# ── Auth (NextAuth + Google OAuth) ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_AUTH_DEBUG=false
AFFILIATE_JWT_SECRET=
LOGIN_CODE_EXPIRY_MINUTES=15

# ── Stripe (billing) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ENVIRONMENT=
WEBHOOK_VERBOSE_LOGGING=false
STRIPE_PRODUCT_ID_TRADIE=prod_xxx
STRIPE_PRODUCT_ID_FOREMAN=prod_xxx
STRIPE_PRODUCT_ID_BOSS=prod_xxx
STRIPE_PRICE_ID_TRADIE=price_xxx
STRIPE_PRICE_ID_FOREMAN=price_xxx
STRIPE_PRICE_ID_BOSS=price_xxx

# ── Email (SendGrid) ──
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_DOMAIN=
CONTACT_EMAIL=support@your-domain.com
EMAIL_ENABLED=true
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440
EMAIL_VERIFICATION_RATE_LIMIT_PER_5MIN=3
EMAIL_VERIFICATION_RATE_LIMIT_PER_HOUR=5
PASSWORD_RESET_EXPIRY_MINUTES=1440

# ── SMS (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+61400000000

# ── Media uploads (Cloudinary) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Meta / Facebook (Pixel + Conversions API + Marketing API) ──
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_TEST_EVENT_CODE=
FACEBOOK_USE_TEST_EVENTS=false
FACEBOOK_MARKETING_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=act_xxx

# ── TikTok (Pixel + Events API + Marketing API) ──
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_MARKETING_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_TEST_EVENT_CODE=
TIKTOK_USE_TEST_EVENTS=false

# ── Snapchat (Pixel) ──
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
SNAPCHAT_ACCESS_TOKEN=

# ── Pixel testing gates ──
NEXT_PUBLIC_ENABLE_PIXEL_TESTING=false
NEXT_PUBLIC_PIXEL_ALLOWED_HOSTNAMES=

# ── Google Tag Manager + SEO verification ──
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_ENABLE_GTM_TESTING=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Klaviyo (marketing) ──
KLAVIYO_PRIVATE_API_KEY=pk_xxx
KLAVIYO_ENABLED=true
KLAVIYO_MODE=development
KLAVIYO_SMS_LIST_ID=
KLAVIYO_EMAIL_LIST_ID=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
KLAVIYO_API_REVISION=2025-10-15
KLAVIYO_CONVERSION_METRIC_ID=
KLAVIYO_DEBUG_DELETION=false
KLAVIYO_DEBUG_DRAW_CALC=false
KLAVIYO_DEBUG_PROFILE=false

# ── Rewards ──
REWARDS_ENABLED=false
NEXT_PUBLIC_REWARDS_ENABLED=false
REWARDS_DISABLED_MESSAGE=
NEXT_PUBLIC_REWARDS_DISABLED_MESSAGE=

# ── Partner-discount SSO (iGoDirect / MyRewards) ──
IGODIRECT_SSO_SECRET=
IGODIRECT_CLIENT_ID=2412
IGODIRECT_DOMAIN_CODE=ToolsAustralia
IGODIRECT_DOMAIN_URL=myrewards.toolsaustralia.com.au
PARTNER_DISCOUNT_SSO_ENABLED=
NEXT_PUBLIC_PARTNER_DISCOUNT_SSO_ENABLED=

# ── Internal Norm / OpenClaw AI gateway ──
NORM_BEARER_TOKEN=
NORM_SIGNING_SECRET=
NORM_DISABLED_REGISTRY_KEYS=
NORM_SMOKE_BASE=http://localhost:3000

# ── Support-chat AI (Anthropic + Google Gemini) + hCaptcha ──
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_GENERATIVE_AI_API_KEY=
CHAT_MODEL_PRIMARY=claude-haiku-4-5
CHAT_MODEL_ESCALATION=claude-sonnet-4-6
CHAT_GOOGLE_MODEL_PRIMARY=gemini-2.5-flash-lite
CHAT_GOOGLE_MODEL_ESCALATION=gemini-2.5-flash
CHAT_KILL_SWITCH=false
CHAT_DAILY_TOKEN_BUDGET_USD=5
CHAT_GENERATIVE_LIMIT_MAX=5
CHAT_GENERATIVE_LIMIT_WINDOW_SECONDS=300
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
EVAL_LIMIT=3

# ── Cron + operational scripts ──
CRON_SECRET=
MINI_DRAW_NOTIFICATION_RECIPIENTS=
CONFIRM_BACKFILL_PRODUCTION=
SILENCE_LOGS=false
