# .env.example — the canonical registry of every env var the app reads.
#
# This file is TRACKED (rescued from the `.env*` ignore by `!.env.example` in
# .gitignore) and is the SINGLE SOURCE OF TRUTH for WHICH env vars exist.
#   • .env.local — per-folder VALUES (gitignored; never merges between folders/worktrees)
#   • Vercel     — production values (set them there too)
# There is NO runtime env validation (src/lib/environment.ts only detects NODE_ENV),
# so this list must be kept complete BY HAND.
#
# When you add an env var: register it HERE (with a comment + a SAFE placeholder —
# NEVER a real secret value) in the SAME commit, then set the value in your .env.local,
# the main folder's .env.local, and Vercel. Detect drift with:
#     npm run check:env       # this folder vs .env.example (exits 1 on a missing var)
#     npm run check:env:all   # main folder + every git worktree
# See CLAUDE.md §9.
#
# NOT listed here (legitimately per-folder — allowlisted in scripts/check-env.mjs):
#   PORT              — assigned per-worktree by wt-new.sh (main uses 3000)
#   E2E_TEST_USER_*   — branch-local end-to-end test credentials
#   E2E_MONGODB_URI   — dedicated e2e database (name must contain "e2e"; suite wipes it each run)
#   E2E_PORT          — port the e2e orchestrator boots the app on (default 3799)

# ─── App / runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Tools Australia
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Database (MongoDB + Redis) ─────────────────────────────────────────────────
MONGODB_URI=
MONGODB_MAX_POOL=
REDIS_URL=

# ─── Auth (NextAuth + Google OAuth + verification) ──────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_RESET_EXPIRY_MINUTES=
EMAIL_VERIFICATION_EXPIRY_MINUTES=
EMAIL_VERIFICATION_RATE_LIMIT_PER_5MIN=

# ─── Stripe (billing) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TRADIE=
STRIPE_PRICE_ID_FOREMAN=
STRIPE_PRICE_ID_BOSS=
STRIPE_PRODUCT_ID_TRADIE=
STRIPE_PRODUCT_ID_FOREMAN=
STRIPE_PRODUCT_ID_BOSS=
# Client-side rate limiter in front of the Stripe singleton (src/lib/stripe-rate-limiter.ts).
# LEAVE BOTH BLANK unless you are deliberately tuning. Defaults live in code and are 80% of
# Stripe's published caps: global 80/sec on a live key, 20/sec on a test key (sandbox's global
# cap is 25/sec, not 100), and 20/sec per endpoint. Blank = "use the default for THIS key", so
# a value written here would override the key-aware default — writing 80 on an sk_test_ key
# puts you over the sandbox cap. Set either to 0 to disable that bucket (e.g. an ops script).
# NOTE the limiter is PER-INSTANCE: N concurrent lambdas multiply the aggregate rate.
STRIPE_RATE_LIMIT_GLOBAL_PER_SECOND=
STRIPE_RATE_LIMIT_ENDPOINT_PER_SECOND=

# ─── Email — SendGrid (transactional) ───────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_NAME=Tools Australia
EMAIL_FROM=
EMAIL_ENABLED=false
CONTACT_EMAIL=
EMAIL_RETRY_ATTEMPTS=
EMAIL_RETRY_DELAY_MS=

# ─── SMS — Mobile Message (transactional / OTP) ─────────────────────────────────
# Australian gateway used for mobile-verification and SMS-login codes.
# Dashboard → Settings → API. Basic auth: username:password, base64'd.
# Endpoint: POST https://api.mobilemessage.com.au/v1/messages
#
# Opt-IN, like EMAIL_ENABLED above. Left false, src/lib/sms.ts short-circuits and
# sends nothing — so merging this cannot start billing or texting anyone.
SMS_ENABLED=false
MOBILE_MESSAGE_API_USERNAME=
MOBILE_MESSAGE_API_PASSWORD=
# The dedicated virtual number claimed under Settings → Sender IDs (free with credits).
# Required on every send — the API rejects a message with no `sender`. Using a NUMBER
# rather than a branded alphanumeric ID deliberately bypasses the ACMA SMS Sender ID
# Register (live since 2026-07-01), so codes never carry the "Unverified" handset label.
MOBILE_MESSAGE_SENDER=
# LOCAL DEV ONLY. OTP send rate limiting (3/day, 60s cooldown) is OFF in development so the
# flow can be exercised repeatedly; set this to "true" to force it back ON locally, which is
# the only way to test the limiter itself. Production ALWAYS enforces — no env var can
# disable it there. See src/utils/auth/mobile-otp.ts.
SMS_OTP_RATE_LIMIT_IN_DEV=

# ─── Marketing — Klaviyo ────────────────────────────────────────────────────────
KLAVIYO_ENABLED=false
KLAVIYO_MODE=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_EMAIL_LIST_ID=
KLAVIYO_SMS_LIST_ID=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
# Allow Klaviyo PROFILE writes when KLAVIYO_MODE is not "production".
# Dev and prod share ONE Klaviyo account, so this is OFF by default and a local run
# cannot push test profiles into the live marketing account. Set to "true" ONLY for a
# deliberate ops backfill against production. Events are unaffected — they carry [DEV].
KLAVIYO_ALLOW_DEV_PROFILE_WRITES=false

# ─── Bonus-code webhook (inbound, called by a Klaviyo flow) ─────────────────────
# Guards POST /api/bonus-codes/v1/issue, which MINTS a per-customer bonus code.
# Anyone holding the secret can mint real prize-draw entries — treat it as a
# payment credential, and scope it to Vercel's PRODUCTION environment only.
#
# Shared secret sent in the X-Bonus-Code-Secret header. COMMA-SEPARATED list, so
# a rotation can overlap: add the new one -> marketing updates the three flows ->
# remove the old one. Each entry must be at least 16 characters or it is ignored.
# UNSET (or every entry too short) = the endpoint refuses EVERY call with 500
# "misconfigured". That is deliberate: it fails CLOSED, never open.
# Generate with: openssl rand -hex 32
BONUS_CODE_WEBHOOK_SECRET=
# Max codes the webhook may mint per UTC day. Unset -> 500. An explicit 0 blocks
# all minting (a second break-glass). Anything not a non-negative integer falls
# back to 500 and logs. This cap is the only control that survives a leaked
# secret, so it is evaluated fail-closed — a DB outage blocks minting.
BONUS_CODE_DAILY_MINT_CAP=
# Break-glass. "true" (any casing) stops all webhook minting immediately.
# Anything else, including unset, means off.
BONUS_CODE_KILL_SWITCH=false

# ─── Tracking — Meta / Facebook (Pixel + CAPI) ──────────────────────────────────
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_MARKETING_ACCESS_TOKEN=
FACEBOOK_USE_TEST_EVENTS=false
FACEBOOK_TEST_EVENT_CODE=

# ─── Tracking — TikTok (Pixel + Events API) ─────────────────────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Events API (server-side conversions) token — separate from the Marketing API token below.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# TikTok MARKETING API token (spend/insights sync + future ad→URL destination resolver).
# The API app must be authorized with these scopes, or every call returns code 40001:
#   - Ad Account Management: read  (/advertiser/info — account currency/timezone checks)
#   - Reporting: read              (/report/integrated/get — per-ad + hourly spend sync)
#   - Ads Management: read         (/ad/get — landing-page URLs for the packages-focus resolver)
# After adding scopes, RE-AUTHORIZE the app and regenerate this token (scopes are baked
# into the token at authorization time). Update it here, in the main folder's .env.local,
# AND in Vercel (see CLAUDE.md §9).
TIKTOK_MARKETING_ACCESS_TOKEN=
TIKTOK_USE_TEST_EVENTS=false
TIKTOK_TEST_EVENT_CODE=

# ─── Tracking — Google Analytics / GTM / Hotjar ─────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_ENABLE_GTM_TESTING=false
NEXT_PUBLIC_ENABLE_PIXEL_TESTING=false
NEXT_PUBLIC_PIXEL_ALLOWED_HOSTNAMES=

# ─── Tracking — Contentsquare (session replay) ──────────────────────────────────
# Contentsquare session-replay tag id (the `t.contentsquare.net/uxa/<id>.js` script src).
# Blank disables the script entirely (src/app/layout.tsx no-ops like GoogleTagManager) —
# set only in production; leave blank in dev/e2e.
NEXT_PUBLIC_CONTENTSQUARE_ID=

# ─── Media — Cloudinary + AWS S3 ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ─── Rewards ────────────────────────────────────────────────────────────────────
REWARDS_ENABLED=false
NEXT_PUBLIC_REWARDS_ENABLED=false

# ─── Cron / webhooks / debug ────────────────────────────────────────────────────
CRON_SECRET=
WEBHOOK_VERBOSE_LOGGING=false
NEXT_PUBLIC_ENABLE_AUTH_DEBUG=false

# ─── Stripe webhook worker ──────────────────────────────────────────────────────
# Required: gates the internal worker route POST /api/stripe/process-event.
# Without this, the receiver enqueues Stripe events but every dispatch to the
# worker returns 500 "Worker not configured" and the queue stalls.
# Generate with: openssl rand -hex 32   (32+ chars required)
# See: docs/billing-stripe/STRIPE_WEBHOOK_QUEUE.md
STRIPE_WORKER_INTERNAL_SECRET=

# ─── Internal Norm API — see docs/internal-norm/ ────────────────────────────────
NORM_BEARER_TOKEN=
NORM_SIGNING_SECRET=
NORM_DISABLED_REGISTRY_KEYS=

# ─── iGoDirect / MyRewards SSO ("Tools Australia Rewards") — partner-discount portal ─
# Signs the HS256 JWT for POST https://<domain_url>/generatetoken. Issued per-client
# by MyRewards. The SECRET is sensitive: keep it ONLY in .env.local / Vercel — never
# commit a real value here. The other three are non-secret tenant identifiers
# (production values shown for reference). See docs/auth/igodirect-sso-masterplan.md.
IGODIRECT_SSO_SECRET=
IGODIRECT_CLIENT_ID=2412
IGODIRECT_DOMAIN_CODE=ToolsAustralia
IGODIRECT_DOMAIN_URL=myrewards.toolsaustralia.com.au

# Rewards SSO GO-LIVE GATE. POST /api/partner-discount/sso is INERT in production (returns 404)
# unless this is exactly "true". Keep it UNSET in prod until rewards SSO is cleared to launch
# (after the vendor deprovisioning + member_level + member-deletion/DPA answers). Always enabled
# in local dev so the /dev/rewards-sso harness works. See docs/auth/igodirect-sso-implementation-plan.md.
PARTNER_DISCOUNT_SSO_ENABLED=
# CLIENT twin of the above — gates the portal UI (the dashboard "Reward portal" button +
# the Rewards-page "Open partner portal" button; shows "Coming soon" while unset). The route
# reads the server var above; client-rendered buttons can only read NEXT_PUBLIC_* vars, so set
# BOTH to the same value. Read via partnerDiscountSsoEnabled() in src/config/featureFlags.ts.
NEXT_PUBLIC_PARTNER_DISCOUNT_SSO_ENABLED=

# Public origin of the partner rewards portal, used ONLY to deep-link a single offer from
# /my-account/rewards/catalogue (`{origin}/products/view_smart/{offerId}`). Public hostname,
# not a secret. Unset = the catalogue renders plain rows instead of links, which is a safe
# degrade — the deep link needs a live portal session anyway, so it is a convenience, never
# the primary path to redemption. Read via buildPartnerPortalOfferUrl().
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://myrewards.example.com

# Public base of the partner portal's MEDIA bucket, used to show offer artwork on
# /my-account/rewards/catalogue (`{base}/product_image/{offerId}.{ext}` — the extension
# varies per offer and is resolved once by scripts/probe-partner-catalog-images.ts).
# Public, not a secret. No trailing slash.
#
# Coverage is 948/1833 and the gap is STRUCTURAL, not random: every category is at
# 97-100% except "In-Store Offer" (877 offers), which is at 0% because those are keyed
# by an internal media id we are not given. Misses return 403, so the UI always renders
# the monogram fallback tile. Unset = no artwork anywhere, which is a safe degrade.
NEXT_PUBLIC_PARTNER_MEDIA_URL=https://s3-ap-southeast-2.amazonaws.com/example-media/webroot/files

# LOCAL-DEV ONLY: lights up the Membership Streak dashboard surfaces (card, milestones
# track, celebration) while git ships them dark. Only meaningful once the streak launch
# runbook has run against the DB your MONGODB_URI points at. NEVER set in Vercel —
# production launches by flipping the committed flags in src/config/dashboardFeatures.ts
# (launch runbook step 4). Read by DASHBOARD_FEATURES via STREAK_PREVIEW.
NEXT_PUBLIC_DASHBOARD_STREAK_PREVIEW=false

# Member-status API bearer secret. iGoDirect's MyRewards portal presents this as
# `Authorization: Bearer <key>` on GET /api/partner-discount/member-status (their live
# read of a member's discount access at sign-in / page load / redemption). WE mint it
# (≥32 random bytes) and hand it to iGoDirect over a secure channel. Sensitive: keep the
# real value ONLY in .env.local / Vercel. Unset ⇒ the route fails CLOSED (500).
# See docs/partner/igodirect-member-status-api-plan.md.
IGODIRECT_MEMBER_STATUS_KEY=
# Member-status GO-LIVE GATE. GET /api/partner-discount/member-status returns 503
# {"error":"disabled"} in production unless this is exactly "true". Always enabled in
# local dev. Flip in Vercel when iGoDirect is ready to point their portal at us.
IGODIRECT_MEMBER_STATUS_ENABLED=

# ─── Affiliate ──────────────────────────────────────────────────────────────────
# Optional: dedicated secret for the AFFILIATE portal's JWT (affiliate_token).
# When set, affiliate tokens are cryptographically separated from the member /
# NextAuth tokens (which use NEXTAUTH_SECRET) and can be rotated independently.
# Falls back to NEXTAUTH_SECRET when unset, so the app still works without it.
# NOTE: setting (or later rotating) this invalidates all existing affiliate
# sessions — affiliates simply log in again once. Generate: openssl rand -hex 32
# See: docs/auth/SECRET_ROTATION.md
AFFILIATE_JWT_SECRET=

# ─── Production DB probe ─────────────────────────────────────────────────────────
# Optional: a SEPARATE, explicit connection string to the PRODUCTION database,
# used ONLY by read-only verification probes/reconciliation runs (e.g.
# temp/readonly/*.mjs). Keeping prod access in its own var avoids accidentally
# pointing your normal MONGODB_URI at prod. The Atlas connection string usually
# has NO /<dbName> path — the probes resolve the app DB ("Production") at runtime.
# Read-only use only; never run a write/migration against this without intent.
PROD_MONGODB_URI=

# ─── AI support chatbot (Cobber) — docs/ai-chatbot/ ─────────────────────────────
# First-party Anthropic API key. Set a low customer-set monthly SPEND LIMIT
# in the Anthropic Console (it hard-stops at the cap) as the provider-side cost ceiling.
# This is a FAQ-only bot — no member account data is accessed via the chat.
ANTHROPIC_API_KEY=
# Cheapest capable model for the LLM fallback; escalation model for rare hard cases.
CHAT_MODEL_PRIMARY=claude-haiku-4-5
CHAT_MODEL_ESCALATION=claude-sonnet-4-6
# App-level daily spend ceiling (USD). The cost guard flips to a canned "support is
# busy" reply (no LLM call) once a UTC day's estimated spend exceeds this. Fail-closed.
CHAT_DAILY_TOKEN_BUDGET_USD=5
# Break-glass kill switch — set to "true" to disable Cobber instantly: hides the
# chat bubble site-wide AND blocks the generative path (canned "busy" reply, no
# LLM call). This is the env OVERRIDE — it wins over, and locks, the admin
# "Cobber availability" Pause toggle (Admin → Team → Chatbot), which is DB-backed
# and needs no deploy. For normal pausing prefer the admin toggle; use this when
# you can't reach the admin panel. Mirrors the Norm gateway kill-switch.
CHAT_KILL_SWITCH=false
# hCaptcha — guest generative gate (Task 1.8).
# Server secret for POST https://api.hcaptcha.com/siteverify (fail-closed:
# if HCAPTCHA_SECRET is unset, ALL anonymous generative turns are blocked;
# FAQ deflection and authenticated members are unaffected).
# Client sitekey is public and used by the Task 1.9 widget.
# Get both from https://dashboard.hcaptcha.com/
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# OPEN guest generative access WITHOUT hCaptcha: set "true" and anonymous guests reach
# the LLM directly (routed to the cheap Gemini provider — see resolveActorProvider),
# protected only by the per-IP generative rate limit + the daily budget. Default off =
# guests stay FAQ-only (fail-closed). When on, requires GOOGLE_GENERATIVE_AI_API_KEY
# (guests always use Gemini) or guest turns fall back to the canned reply.
CHAT_ALLOW_GUEST_GENERATIVE=false
# Per-user LLM-answer rate cap. FAQ deflection is NEVER counted against this limit —
# only genuine model-backed answers are. Limiter fails open (Mongo hiccup allows).
# The daily budget (fail-closed) remains the cost backstop.
# Defaults: 5 LLM answers per 300 seconds (5 minutes) per user (member → userId, anon → IP).
CHAT_GENERATIVE_LIMIT_MAX=5
CHAT_GENERATIVE_LIMIT_WINDOW_SECONDS=300
# GOOGLE_GENERATIVE_AI_API_KEY — read automatically by @ai-sdk/google. Required when
# EITHER the admin toggles the member provider to Gemini, OR CHAT_ALLOW_GUEST_GENERATIVE
# is on (guests ALWAYS use Gemini). Unset → those turns fall back to the canned reply.
# Gemini model IDs override defaults (gemini-2.5-flash-lite / gemini-2.5-flash).
GOOGLE_GENERATIVE_AI_API_KEY=
CHAT_GOOGLE_MODEL_PRIMARY=gemini-2.5-flash-lite
CHAT_GOOGLE_MODEL_ESCALATION=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────────
# Partner in-store artwork harvest (scripts/harvest-partner-instore-artwork.ts)
# ─────────────────────────────────────────────────────────────────────────────────
# DELIBERATELY COMMENTED OUT, not declared. These are read by an occasional ops script,
# never by the app, so declaring them live would make `npm run check:env` report them
# MISSING in every folder forever. Set them inline for the one command instead:
#
#   PARTNER_HARVEST_EMAIL=... PARTNER_HARVEST_PASSWORD=... npm run harvest:partner-instore-artwork
#
# Needs a member account with ACTIVE partner access — the script signs in to Tools
# Australia and uses the normal SSO hand-off, because the portal has no other entry.
# Read-only against the vendor: it reads listing pages, never redeems or edits.
#
# PARTNER_HARVEST_EMAIL=member@example.com
# PARTNER_HARVEST_PASSWORD=
# PARTNER_HARVEST_ORIGIN=https://toolsaustralia.com.au   # optional; defaults to prod

# ─────────────────────────────────────────────────────────────────────────────────
# Print provider — TeePrintCentre (runs on the Riverr platform)
# ─────────────────────────────────────────────────────────────────────────────────
# Fulfilment for the shop's merchandise. Both values come from the TeePrintCentre
# portal at https://app.teeprintcentre.com.au — see docs/superpowers/specs/
# 2026-08-17-shop-merchandise-design.md.
#
# RIVERR_API_BASE_URL — optional override of the provider host. Shared by BOTH
# surfaces: REST is `<base>/…` and GraphQL is `<base>/graphql`, so this is
# deliberately not split per-API. Defaults to https://api.riverr.app when unset.
RIVERR_API_BASE_URL=

# RIVERR_REST_API_KEY — Settings → API Keys → copy the "User ID (UID)". This IS the key;
# there is no token exchange. It is sent as the `x-uid` header on every request and
# identifies the whole account, so it is SERVER-SIDE ONLY — never expose it to a
# browser and never prefix it with NEXT_PUBLIC_.
RIVERR_REST_API_KEY=

# RIVERR_GRAPHQL_API_KEY — the `rv_live_…` value from Settings → Account → API keys.
# A SECOND, DIFFERENT key from RIVERR_REST_API_KEY above, and the two are not
# interchangeable — the provider runs two APIs and each key works on exactly one:
#
#   RIVERR_REST_API_KEY          (short UID)  -> REST  https://api.riverr.app/...
#                                           reads: /design-library, product detail
#   RIVERR_GRAPHQL_API_KEY  (rv_live_…)  -> GraphQL https://api.riverr.app/graphql
#                                           writes: createOrder, createOrderFromGtin
#
# Verified 2026-08-20: the UID gets 500 "User not found" on GraphQL, and the
# rv_live_ key gets 403 on REST. Swapping them looks like an auth outage.
# Server-side only — never NEXT_PUBLIC_.
RIVERR_GRAPHQL_API_KEY=

# RIVERR_SHOP_ID — the store the orders are booked against ("Stores" in the portal).
# `shopId` is a required field on createOrder / createOrderFromGtin. A store does NOT
# need a Shopify/Etsy connection — createShop takes only a name, so a headless store
# for toolsaustralia.com.au is valid.
RIVERR_SHOP_ID=

# Production endpoint is https://api.riverr.app/graphql and is hardcoded in the
# adapter. Do NOT use https://dev.riverr.app/graphql — it is a legacy hostname kept
# alive for old integrations. There is no sandbox environment.
# ── Automated past-due charge run (cron) ─────────────────────────────────────
# Opt-IN. Unset/false = the cron endpoint no-ops, so deploying it changes nothing.
CHARGE_CRON_ENABLED=false
# Admin User _id the automated run is attributed to on ChargeJobRun + InvoiceChargeLog.
# Required — the cron refuses to run without a valid ObjectId here.
CHARGE_CRON_ADMIN_USER_ID=
# Local (Australia/Sydney) hour to START the daily run, 0-23. A run may begin
# within startHour..startHour+2; resume ticks ignore it entirely. Requires
# CRON_SECRET to be set - this route fails closed without it.
CHARGE_CRON_START_HOUR=7
# Delay between individual charges, ms. Sequential; this tunes the sustained
# rate. 2000 ≈ 20/min vs the admin path's ~196/min burst.
CHARGE_CRON_DELAY_MS=2000
# Refuse to charge if the worklist exceeds this (something upstream is wrong).
CHARGE_CRON_MAX_WORKLIST=3000
# Work budget per invocation, ms. Must stay under the 300s function cap.
CHARGE_CRON_BUDGET_MS=240000
