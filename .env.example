# .env.example — checked-in scaffold for local setup.
#
# This file is NOT exhaustive. It only documents env vars that have bitten
# onboarding before and aren't auto-validated by lib/environment.ts.
# Copy any missing keys into .env.local and fill in real values.

# Required: gates the internal worker route POST /api/stripe/process-event.
# Without this, the receiver enqueues Stripe events but every dispatch to the
# worker returns 500 "Worker not configured" and the queue stalls.
# Generate with: openssl rand -hex 32   (32+ chars required)
# See: docs/billing-stripe/STRIPE_WEBHOOK_QUEUE.md
STRIPE_WORKER_INTERNAL_SECRET=

# Internal Norm API — see docs/internal-norm/
NORM_BEARER_TOKEN=
NORM_SIGNING_SECRET=
NORM_DISABLED_REGISTRY_KEYS=

# iGoDirect / MyRewards SSO ("Tools Australia Rewards") — partner-discount portal.
# Signs the HS256 JWT for POST https://<domain_url>/generatetoken. Issued per-client
# by MyRewards. The SECRET is sensitive: keep it ONLY in .env.local / Vercel — never
# commit a real value here. The other three are non-secret tenant identifiers
# (production values shown for reference). See docs/auth/igodirect-sso-masterplan.md.
IGODIRECT_SSO_SECRET=
IGODIRECT_CLIENT_ID=2412
IGODIRECT_DOMAIN_CODE=ToolsAustralia
IGODIRECT_DOMAIN_URL=myrewards.toolsaustralia.com.au

# Optional: dedicated secret for the AFFILIATE portal's JWT (affiliate_token).
# When set, affiliate tokens are cryptographically separated from the member /
# NextAuth tokens (which use NEXTAUTH_SECRET) and can be rotated independently.
# Falls back to NEXTAUTH_SECRET when unset, so the app still works without it.
# NOTE: setting (or later rotating) this invalidates all existing affiliate
# sessions — affiliates simply log in again once. Generate: openssl rand -hex 32
# See: docs/auth/SECRET_ROTATION.md
AFFILIATE_JWT_SECRET=

# Optional: a SEPARATE, explicit connection string to the PRODUCTION database,
# used ONLY by read-only verification probes/reconciliation runs (e.g.
# temp/readonly/*.mjs). Keeping prod access in its own var avoids accidentally
# pointing your normal MONGODB_URI at prod. The Atlas connection string usually
# has NO /<dbName> path — the probes resolve the app DB ("Production") at runtime.
# Read-only use only; never run a write/migration against this without intent.
PROD_MONGODB_URI=

# --- AI support chatbot (docs/ai-chatbot/) ---
# First-party Anthropic API key. Set a low customer-set monthly SPEND LIMIT
# in the Anthropic Console (it hard-stops at the cap) as the provider-side cost ceiling.
# This is a FAQ-only bot — no member account data is accessed via the chat.
ANTHROPIC_API_KEY=
# Cheapest capable model for the LLM fallback; escalation model for rare hard cases.
CHAT_MODEL_PRIMARY=claude-haiku-4-5
CHAT_MODEL_ESCALATION=claude-sonnet-4-6
# App-level daily spend ceiling (USD). The cost guard flips to a canned "support is
# busy" reply (no LLM call) once a UTC day's estimated spend exceeds this. Fail-closed.
CHAT_DAILY_TOKEN_BUDGET_USD=5
# Manual kill switch — set to "true" to disable the generative bot instantly
# (FAQ search still works). Mirrors the Norm gateway kill-switch.
CHAT_KILL_SWITCH=false
# hCaptcha — guest generative gate (Task 1.8).
# Server secret for POST https://api.hcaptcha.com/siteverify (fail-closed:
# if HCAPTCHA_SECRET is unset, ALL anonymous generative turns are blocked;
# FAQ deflection and authenticated members are unaffected).
# Client sitekey is public and used by the Task 1.9 widget.
# Get both from https://dashboard.hcaptcha.com/
HCAPTCHA_SECRET=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
